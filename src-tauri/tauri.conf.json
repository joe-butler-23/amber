{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Amber",
    "version": "0.20.0",
    "identifier": "dev.amberapp.amber",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "Amber",
                "width": 1200,
                "height": 1000,
                "dragDropEnabled": false
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "shortDescription": "Distraction-free, minimalist yet powerful incremental learning \u2014 free and open source.",
        "icon": [
            "icons/32x32.png",
            "icons/128x128@2x.png",
            "icons/128x128.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
